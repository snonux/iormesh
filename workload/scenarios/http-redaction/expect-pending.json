{"scenario": "http-redaction",
 "schema_version": 1,
 "events": [
   {"process": "$p1", "thread": "$t1", "event": "accept", "args": {"local_port": "$port1"}, "fd": "$fd1", "attribution": "java"},
   {"process": "$p1", "thread": "$t1", "event": "read", "fd": "$fd1", "attribution": "java"},
   {"process": "$p1", "thread": "$t1", "event": "write", "fd": "$fd1", "attribution": "java"},
   {"process": "$p1", "thread": "$t1", "event": "http", "conn_id": "$c1", "attribution": "java", "java": {"method": "iormesh.workload.scenarios.HttpServe#handle"}, "http": {"method": "GET", "scheme": "http", "path": "/redact/login?user=***&token=***", "status": 200, "req_seq": 1}},
   {"process": "$p1", "thread": "$t1", "event": "read", "fd": "$fd1", "attribution": "java"},
   {"process": "$p1", "thread": "$t1", "event": "write", "fd": "$fd1", "attribution": "java"},
   {"process": "$p1", "thread": "$t1", "event": "http", "conn_id": "$c1", "attribution": "java", "java": {"method": "iormesh.workload.scenarios.HttpServe#handle"}, "http": {"method": "GET", "scheme": "http", "path": "/redact/profile", "status": 200, "req_seq": 2}},
   {"process": "$p2", "thread": "$t2", "event": "connect", "args": {"remote_port": "$port1"}, "fd": "$fd2", "attribution": "java"},
   {"process": "$p2", "thread": "$t2", "event": "http", "conn_id": "$c1", "attribution": "java", "java": {"method": "iormesh.workload.scenarios.HttpFetch#call"}, "http": {"method": "GET", "scheme": "http", "host": "127.0.0.1", "path": "/redact/login?user=***&token=***", "status": 200, "req_seq": 1}},
   {"process": "$p2", "thread": "$t2", "event": "http", "conn_id": "$c1", "attribution": "java", "java": {"method": "iormesh.workload.scenarios.HttpFetch#call"}, "http": {"method": "GET", "scheme": "http", "host": "127.0.0.1", "path": "/redact/profile", "status": 200, "req_seq": 2}},
   {"process": "$p2", "thread": "$t3", "event": "read", "fd": "$fd2", "attribution": "java"}
 ],
 "edges": [
   {"type": "connected", "from": "$p1", "to": "conn:$c1", "state": "fused"},
   {"type": "connected", "from": "$p2", "to": "conn:$c1", "state": "fused"}
 ],
 "must_not_appear": ["Hunter2PlantedAuthHeader", "Hunter2PlantedApiTokenHeader", "Hunter2PlantedQuerySecret", "Hunter2PlantedSessionCookie",
                     "Hunter2PlantedSetCookie"]}
