# Build outputs (docs/decisions.md #30, tasks rk4/uk4): the binaries,
# the four jars and the gates' test binaries all go to bin/, which `mage
# clean` removes; none is written to the repository root.
/bin/
/workload/classes/

# BPF build outputs and inputs (as in ior): the object is rebuilt by
# `mage bpfBuild`; vmlinux.h is dumped from the build host's BTF by
# ensureVMLINUX and kept out of git like ior keeps it.
*.o
vmlinux.h
# mage generate transients (removed by defer; swept by `mage clean`).
*.new
internal/c/generated_tracepoints.c.tmp-*
*.test

# Java agent build (mage agentBuild).
/agent/build/

# The OTEL workload flavor (mage workloadOtelBuild).
/workload/otel/classes/

# The third-party HTTP workload module (mage workloadLibsBuild).
/workload/libs/classes/

# Agent worktrees (Claude Code isolation)
/.claude/worktrees/

# Release binaries of the container builds (mage buildDocker/buildPodman).
/dist/

# The LLM introspection's recorded store (mage evalTrace); its results
# under eval/results/ are kept.
/eval/store/

# The M8 agent trial's runs (mage agentTrial, decision #37): transcripts,
# command logs and the docs copy of each run; its results under
# eval/agent-trial/results/ are kept.
/eval/agent-trial/runs/

# The acceptance runs' state directory (mage k8sAcceptance, task yb4,
# decision #30): the kind cluster's kubeconfig (credentials, never
# committed), the base-image and existing-cluster state files and the
# interrupted teardown's log.
/.k8s-acceptance/
