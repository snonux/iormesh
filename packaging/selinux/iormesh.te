policy_module(iormesh, 0.1.0)

########################################
#
# iormesh_container_t: the in-pod tracer's SELinux type (PLAN.md #13,
# task 7h4), an opt-in alternative to the default spc_t. It is a
# container domain built like container_t - container-selinux's own
# template, so containerd may transition to it, it manages
# container_file_t, and it stays MCS-constrained - plus only what the
# tracer needs that container_t lacks, measured on el9 (tasks zg4, 7h4):
# BPF programs and maps, the perf events that attach tracepoints, a
# read-only view of tracefs for the tracepoint ids, and the Java attach
# to the app containers' JVMs (container_t), found by task 7h4's
# audit2allow review of a permissive run.
#
# Capabilities: this module grants none. Six of the tracer's seven (bpf,
# perfmon, checkpoint_restore, sys_ptrace, sys_resource, dac_override;
# all but kill) reach the type only through container-selinux's
# virt_sandbox_use_all_caps boolean (on by default), as they reach
# container_t; with it off the BPF load fails on capability2 { bpf
# perfmon }. Leave the boolean on (getsebool virt_sandbox_use_all_caps).
#
# MCS: like container_t it is MCS-constrained, but MCS does not gate
# every rule below. It gates the signal, file and lnk_file reads, dir
# search and read, and writes to filesystem sockets: run the tracer at
# the pod's own MCS pair (iormeshctl deploy -selinux-level s0:cN,cM),
# where those reach the pod's app containers and any container_t at
# plain s0; at the default s0 the app's files (/proc/<pid>/root) and
# processes are out of reach, so the Java attach is denied. Not gated:
# unix_stream_socket connectto (an abstract socket is bounded by the
# pod's network namespace), file open/getattr and dir getattr (bounded
# by what the tracer's PID namespace shows). Pods sharing one pinned
# pair (replicas of a Deployment, a namespace) are not separated by MCS
# at all; there containment rests on the namespaces.
#
# Build: mage selinuxRPM (packaging/selinux/build.sh); unit tests in
# packaging/selinux/policy_test.go pin the permission sets below.
#

gen_require(`
	attribute container_net_domain;
	attribute container_user_domain;
	attribute sandbox_net_domain;
	attribute sandbox_caps_domain;
	attribute svirt_sandbox_domain;
	type container_t;
	type container_file_t;
	type tracefs_t;
	class bpf { map_create map_read map_write prog_load prog_run };
	class perf_event { open cpu kernel read write tracepoint };
	class dir { search read open getattr };
	class file { open read getattr };
	class lnk_file { read };
	class process { signal };
	class unix_stream_socket { connectto };
')

# The type, entrypoint container_file_t, container_file_t managed, MCS
# constrained, system_r: container-selinux's template, as for
# container_t.
container_domain_template(iormesh_container, container)

# container_t's attributes beside the template's, so the tracer has the
# same network, user-namespace, capability and sandbox rules an app
# container has; the tracer's capabilities themselves stay bounded by
# the pod spec (#13's seven).
typeattribute iormesh_container_t container_net_domain, container_user_domain;
typeattribute iormesh_container_t sandbox_net_domain, sandbox_caps_domain;
typeattribute iormesh_container_t svirt_sandbox_domain;

# Load and run the tracing programs, create and use their maps and the
# ring buffer (container_t is denied bpf { prog_load } outright).
allow iormesh_container_t self:bpf { map_create map_read map_write prog_load prog_run };

# perf_event_open for each classic tracepoint the programs attach to.
allow iormesh_container_t self:perf_event { open cpu kernel read write tracepoint };

# The host's tracefs, mounted read-only (hostPath /sys/kernel/tracing):
# libbpf reads each tracepoint's id under events/.
allow iormesh_container_t tracefs_t:dir { search read open getattr };
allow iormesh_container_t tracefs_t:file { open read getattr };

# The Java attach (decision #14, -agent/-spool, attach), to the app
# containers' JVMs, which run as container_t at the pod's pair (MCS
# keeps other pods out): /proc/<pid> search and getattr, and its
# cmdline, maps and environ read (file read is also SELinux's check of
# the ptrace read access /proc/<pid>/root and cwd take); its exe, root
# and cwd links; the one SIGQUIT that starts HotSpot's attach listener;
# and the connect to the JVM's attach socket. Without these the BPF
# tracing works and the agent never joins: container-selinux's
# dontaudit of container_domain on other domains' /proc dirs leaves no
# AVC in the audit log (task 7h4).
allow iormesh_container_t container_t:dir { search getattr };
allow iormesh_container_t container_t:file { open read getattr };
allow iormesh_container_t container_t:lnk_file read;
allow iormesh_container_t container_t:process signal;
allow iormesh_container_t container_t:unix_stream_socket connectto;
