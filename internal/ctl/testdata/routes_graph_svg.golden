<svg xmlns="http://www.w3.org/2000/svg" width="1960" height="300" viewBox="0 0 1960 300" font-family="monospace" font-size="11">
<style>rect{fill:#fff;stroke:#333}rect.host{fill:#e8eef8}rect.app{fill:#eef8e8}rect.socket{fill:#f8f0e8}rect.more{fill:#f4f4f4;stroke-dasharray:3 3}line{stroke:#888}line.unresolved{stroke:#c33;stroke-dasharray:6 4}line.fused{stroke:#36c;stroke-width:1.5}text.title{font-weight:bold}rect.fqdn{fill:#f0e8f8}rect.ingress{fill:#f8e8f0}rect.service{fill:#e8f8f4}rect.workload{fill:#e8f4f8}rect.pod{fill:#f4f8e8}rect.flag{fill:#c33;stroke:#c33}line.routed{stroke:#939;stroke-width:1.5;stroke-dasharray:6 3}text.flag{fill:#c33}</style>
