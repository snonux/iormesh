<svg xmlns="http://www.w3.org/2000/svg" width="1340" height="540" viewBox="0 0 1340 540" font-family="monospace" font-size="11">
<style>rect{fill:#fff;stroke:#333}rect.note{fill:#fdf6d8;stroke:#c9b458}line.life{stroke:#bbb;stroke-dasharray:2 2}line.step{stroke:#222}line.time-ordered{stroke:#666;stroke-dasharray:6 4}line.unordered{stroke:#c33;stroke-dasharray:2 3}text.title{font-weight:bold}</style>
<defs><marker id="arrow" viewBox="0 0 10 10" refX="10" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z"/></marker></defs>
