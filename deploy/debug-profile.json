{
  "env": [
    {
      "name": "POD_NAME",
      "valueFrom": {
        "fieldRef": {
          "fieldPath": "metadata.name"
        }
      }
    },
    {
      "name": "POD_NAMESPACE",
      "valueFrom": {
        "fieldRef": {
          "fieldPath": "metadata.namespace"
        }
      }
    },
    {
      "name": "POD_UID",
      "valueFrom": {
        "fieldRef": {
          "fieldPath": "metadata.uid"
        }
      }
    }
  ],
  "securityContext": {
    "allowPrivilegeEscalation": false,
    "capabilities": {
      "add": [
        "BPF",
        "PERFMON",
        "SYS_RESOURCE",
        "SYS_PTRACE",
        "DAC_OVERRIDE",
        "KILL",
        "CHECKPOINT_RESTORE"
      ],
      "drop": [
        "ALL"
      ]
    },
    "runAsUser": 0,
    "seLinuxOptions": {
      "level": "s0",
      "type": "spc_t"
    },
    "seccompProfile": {
      "type": "RuntimeDefault"
    }
  },
  "volumeMounts": [
    {
      "mountPath": "/sys/kernel/tracing",
      "name": "tracefs",
      "readOnly": true
    },
    {
      "mountPath": "/opt/iormesh/data",
      "name": "iormesh-traces"
    }
  ]
}
